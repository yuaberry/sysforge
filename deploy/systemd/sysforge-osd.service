[Unit]
Description=SYSFORGE — daemon (sysforge-osd) modo sistema
Documentation=https://github.com/yuaberry/sysforge
Requires=sysforge-osd.socket
After=network.target

[Service]
Type=simple
ExecStart=/usr/local/bin/sysforge-osd --system
User=root
Group=root
# hardening: mínimo necessário para Fase 1 (leitura). A Fase 5 (UKI/ESP)
# adicionará ReadWritePaths=/boot/efi com justificativa em SECURITY.md.
NoNewPrivileges=yes
ProtectSystem=strict
# read-only, não yes: o daemon precisa LER a ISO do usuário em /home/...
# (método disco sem pendrive). Escrita em /home: NUNCA — o sandbox bloqueia.
ProtectHome=read-only
PrivateTmp=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
# O método disco (sem pendrive) precisa escrever em 4 lugares, nada além:
#  - /etc/grub.d        (entrada 40_sysforge — arquivo próprio, reversível)
#  - /etc/default       (GRUB_DEFAULT=saved, pré-requisito do grub-reboot)
#  - /boot/grub         (grub.cfg pelo update-grub + grubenv pelo grub-reboot)
ReadWritePaths=/var/lib/sysforge /etc/grub.d /etc/default /boot/grub
StandardOutput=journal
StandardError=journal
SyslogIdentifier=sysforge-osd

[Install]
WantedBy=multi-user.target
